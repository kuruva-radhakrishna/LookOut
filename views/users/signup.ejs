<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-5">
  <div class="col-xl-6 col-lg-8 col-sm-10 offset-sm-1 offset-lg-2 offset-xl-3">
    <h4 class="mt-3">SignUp</h4>
    <form method="post" action="/signup" novalidate class="needs-validation mt-3">
      <div class="mb-3">
        <label for="username" class="form-label">username</label>
        <input
          name="username"
          type="text"
          placeholder="Ramesh"
          class="form-control"
          required
        />
        <div class="valid-feedback">looks good</div>
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">email</label>
        <input
          name="email"
          type="email"
          placeholder="abc@gmail.com"
          class="form-control"
          required
        />
        <div class="valid-feedback">looks good</div>
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">password</label>
        <input
          name="password"
          type="password"
          class="form-control"
          required
        />
        <div class="valid-feedback">looks good</div>
        <div class="row" style="display: flex;align-items: baseline;margin-left: 5px;">
          <button class="btn btn-success mt-3 col-2 ">Signup</button>
          <p class="col-10">Already have an account ? <a href="/login">Login</a></p>
        </div> 
      </div>
    </form>
  </div>
</div>
