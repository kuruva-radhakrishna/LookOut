# --- required ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/lookout?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
# Comma separated browser origins allowed to call the API (your Vercel URL, no trailing slash)
CLIENT_URL=http://localhost:5173

# --- payments (optional) ---
# Leave blank to run in DEMO mode (no money moves; the checkout page shows a simulated payment).
# Use Razorpay *test* keys (rzp_test_...) from Dashboard -> Account & Settings -> API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when adding the webhook (event: payment.captured) -> https://<api>/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- images (optional) ---
# Without these, listings are created from an image URL instead of a file upload.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- misc (optional) ---
MAPBOX_TOKEN=          # geocoding; falls back to OpenStreetMap Nominatim
BOOKING_HOLD_MINUTES=10
PORT=5000
