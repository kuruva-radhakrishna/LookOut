# Base URL of the backend (no trailing slash, no /api). Set this in Vercel -> Project -> Environment Variables.
VITE_API_URL=http://localhost:5000

# Public Mapbox token (pk.*). Enables the Mapbox map and the by-road distance/time from the guest's location.
# Without it the app falls back to an OpenStreetMap map and a straight-line distance.
# In the Mapbox dashboard, restrict this token to your site's URL(s).
VITE_MAPBOX_TOKEN=
